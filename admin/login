<?php

session_start();

if (!empty($_SESSION['admin_logged_in'])) {
    header('Location: panel.php');
    exit;
}

$error = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $password =
        $_POST['password'] ?? '';

    /*
     * Change ce mot de passe.
     */
    $adminPassword =
        'CHANGE_ME_123!';

    if (hash_equals(
        $adminPassword,
        $password
    )) {

        session_regenerate_id(true);

        $_SESSION['admin_logged_in'] =
            true;

        header('Location: panel.php');

        exit;
    }

    $error =
        'Mot de passe incorrect.';
}

?>

